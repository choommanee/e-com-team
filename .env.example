# ---- Server ----
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
OUTPUT_DIR=./output
WORKER_COUNT=3

# ---- Modes: "mock" (no keys needed) or "real" ----
AI_MODE=mock
BILLING_MODE=mock

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string

# ---- Seed login (created on startup, idempotent) ----
# In mock mode a demo account is created by default: demo@ecom.dev / demo1234
# Set your own here, or SEED_EMAIL=off to disable seeding.
SEED_EMAIL=
SEED_PASSWORD=
SEED_PLAN=pro

# ---- OpenAI (needed when AI_MODE=real) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# ---- Postgres (leave empty to run with the in-memory store) ----
DATABASE_URL=postgres://ecom:ecom@localhost:5432/ecom?sslmode=disable

# ---- LemonSqueezy (needed when BILLING_MODE=real) ----
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LS_VARIANT_PRO=
LS_VARIANT_BUSINESS=
